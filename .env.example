# ===== Variables de entorno para Vercel (Proyecto → Settings → Environment Variables) =====

# MongoDB Atlas — cadena de conexión del cluster (Database → Connect → Drivers)
# Ejemplo: mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini API Key — gratuita con límites generosos (1M tokens/día)
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secreto largo y aleatorio para firmar los tokens de sesión
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=
